# Copy to .env and fill in. Read by `docker compose` for ${...} substitution.

# Public site URL for SEO (canonical / OpenGraph / sitemap). Blank → http://localhost:3000
SITE_URL=

# PostgreSQL used by Docker. All values are required; do not commit the real .env.
POSTGRES_DB=e_kit
POSTGRES_USER=e_kit
POSTGRES_PASSWORD=replace-with-a-strong-random-password
DATABASE_URL=postgresql://e_kit:replace-with-a-url-encoded-password@postgres:5432/e_kit?schema=public
