// VoltHouse backend — data model (SQLite: portable, no external DB server)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id
  name          String
  category      String // inverter | battery | solar
  price         Int
  originalPrice Int?
  power         String?
  capacity      String?
  efficiency    String?
  warranty      String
  badge         String?
  features      String // JSON-encoded string[]
  image         String
  images        String   @default("[]") // JSON-encoded string[] of uploaded image URLs
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  brandSlug     String?
  brand         Brand?   @relation(fields: [brandSlug], references: [slug], onDelete: SetNull)
  supplierPrices SupplierPrice[]

  @@index([brandSlug])
}

model Brand {
  slug        String    @id
  name        String    @unique
  logo        String    @default("")
  description String    @default("")
  country     String    @default("")
  enabled     Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Editable homepage sections (a mini page-builder). Each section renders a
// product grid (picked ids or a whole category) or a call-to-action band.
model HomeSection {
  id         String   @id @default(cuid())
  title      String   @default("")
  subtitle   String   @default("")
  mode       String   @default("products") // products | category | cta
  category   String   @default("") // for mode=category (source) and default CTA target
  productIds String   @default("[]") // JSON string[] for mode=products
  ctaLabel   String   @default("") // button label; "" hides the button
  ctaHref    String   @default("") // button target; empty + category → /products?category=<category>
  enabled    Boolean  @default(true)
  sortOrder  Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Testimonial {
  id        String   @id
  name      String
  location  String
  rating    Int
  text      String
  avatar    String
  product   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Lead {
  id        String   @id @default(cuid())
  type      String // order | consultation | callback
  name      String
  phone     String
  email     String?
  interest  String?
  message   String?
  items     String? // JSON-encoded [{ id, name, price, quantity }]
  total     Int?
  status    String   @default("new") // new | contacted | proposal | won | lost
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Supplier {
  id          String          @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  website     String?
  notes       String          @default("")
  active      Boolean         @default(true)
  prices      SupplierPrice[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SupplierPrice {
  id           String   @id @default(cuid())
  supplierId   String
  productId    String
  price        Int
  currency     String   @default("USD")
  availability String   @default("in_stock") // in_stock | preorder | unavailable
  leadTimeDays Int?
  minOrderQty  Int      @default(1)
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt

  @@unique([supplierId, productId])
  @@index([productId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Product categories — editable in admin (label, icon, order, visibility).
model Category {
  key           String  @id // inverter | battery | solar | station | ...
  label         String // plural, e.g. "Інвертори"
  labelSingular String  @default("")
  description   String  @default("")
  icon          String  @default("📦") // emoji shown on the storefront tile
  sortOrder     Int     @default(0)
  enabled       Boolean @default(true)
  parentKey     String?
  parent        Category?  @relation("CategoryTree", fields: [parentKey], references: [key], onDelete: SetNull)
  children      Category[] @relation("CategoryTree")

  @@index([parentKey])
}

// Editable marketing/text blocks. `productIds` (JSON array) lets a block show products.
model ContentBlock {
  key        String   @id // hero | how_it_works | contact | promo | ...
  heading    String?
  subheading String?
  body       String? // free text or JSON, per block
  productIds String   @default("[]") // JSON-encoded string[]
  enabled    Boolean  @default(true)
  sortOrder  Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// Power-calculator appliances (editable in admin).
model Appliance {
  id        String @id
  name      String
  watts     Int
  icon      String
  group     String // essential | kitchen | heavy
  sortOrder Int    @default(0)
}

// Generic key/value store (JSON values) — e.g. calculator recommendation rules.
model Setting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}
