// Read-only compatibility schema used once to import the former SQLite volume.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@legacy/client"
}

datasource db {
  provider = "sqlite"
  url      = env("LEGACY_SQLITE_URL")
}

model Product {
  id String @id
  name String
  category String
  price Int
  originalPrice Int?
  power String?
  capacity String?
  efficiency String?
  warranty String
  badge String?
  features String
  image String
  images String @default("[]")
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  supplierPrices SupplierPrice[]
}

model HomeSection {
  id String @id @default(cuid())
  title String @default("")
  subtitle String @default("")
  mode String @default("products")
  category String @default("")
  productIds String @default("[]")
  ctaLabel String @default("")
  ctaHref String @default("")
  enabled Boolean @default(true)
  sortOrder Int @default(0)
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id String @id
  name String
  location String
  rating Int
  text String
  avatar String
  product String
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
}

model Lead {
  id String @id @default(cuid())
  type String
  name String
  phone String
  email String?
  interest String?
  message String?
  items String?
  total Int?
  status String @default("new")
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Supplier {
  id String @id @default(cuid())
  name String
  contactName String?
  phone String?
  email String?
  website String?
  notes String @default("")
  active Boolean @default(true)
  prices SupplierPrice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupplierPrice {
  id String @id @default(cuid())
  supplierId String
  productId String
  price Int
  currency String @default("USD")
  availability String @default("in_stock")
  leadTimeDays Int?
  arrivalDate DateTime?
  minOrderQty Int @default(1)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  @@unique([supplierId, productId])
  @@index([productId])
}

model AdminUser {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
}

model Category {
  key String @id
  label String
  labelSingular String @default("")
  description String @default("")
  icon String @default("📦")
  sortOrder Int @default(0)
  enabled Boolean @default(true)
}

model ContentBlock {
  key String @id
  heading String?
  subheading String?
  body String?
  productIds String @default("[]")
  enabled Boolean @default(true)
  sortOrder Int @default(0)
  updatedAt DateTime @updatedAt
}

model Appliance {
  id String @id
  name String
  watts Int
  icon String
  group String
  sortOrder Int @default(0)
}

model Setting {
  key String @id
  value String
  updatedAt DateTime @updatedAt
}
