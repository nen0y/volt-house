# ── Server ──
PORT=4000

# ── Database (SQLite) ──
# Local (non-Docker): file lives under prisma/. Docker sets file:/app/data/volthouse.db
DATABASE_URL=file:./volthouse.db

# ── Auth / admin ──
JWT_SECRET=change-this-secret-in-production
ADMIN_EMAIL=omelyazuk@gmail.com
ADMIN_PASSWORD=VoltHouse2024

# ── CORS (frontend origin, or * for any) ──
CORS_ORIGIN=*

# ── Telegram notifications ──
# Leave empty to disable. Fill both to also push every lead to a Telegram group:
#   1) @BotFather -> /newbot -> copy the token into TELEGRAM_BOT_TOKEN
#   2) add the bot to the group; send a message there; open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id (negative for groups)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Uploaded product images ──
# Local: relative to the backend dir. Docker sets /app/data/uploads (persisted).
UPLOAD_DIR=uploads
