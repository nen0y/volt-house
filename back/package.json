{
  "name": "e-kit-backend",
  "version": "1.0.0",
  "private": true,
  "description": "E-Kit store backend — REST API, admin panel and CRM",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "seed:prod": "node dist/seed.js",
    "seed:enrich": "tsx src/seed.ts --enrich",
    "seed:enrich:prod": "node dist/seed.js --enrich",
    "suppliers:reset": "tsx src/reset-suppliers.ts --confirm-supplier-reset",
    "suppliers:reset:prod": "node dist/reset-suppliers.js --confirm-supplier-reset",
    "seed:solarflow": "tsx src/seed-solarflow.ts",
    "seed:solarflow:prod": "node dist/seed-solarflow.js",
    "seed:sig": "tsx src/seed-sig.ts",
    "seed:sig:prod": "node dist/seed-sig.js",
    "seed:yugtorg": "tsx src/seed-yugtorg.ts",
    "seed:yugtorg:prod": "node dist/seed-yugtorg.js",
    "seed:solarbiz": "tsx src/seed-solarbiz.ts",
    "seed:solarbiz:prod": "node dist/seed-solarbiz.js",
    "prices:sync": "tsx src/sync-retail-prices.ts",
    "prices:sync:prod": "node dist/sync-retail-prices.js",
    "fix:inverter-power-fields": "tsx src/fix-inverter-power-fields.ts",
    "fix:inverter-power-fields:apply": "tsx src/fix-inverter-power-fields.ts --apply",
    "fix:inverter-power-fields:prod": "node dist/fix-inverter-power-fields.js",
    "fix:inverter-power-fields:prod:apply": "node dist/fix-inverter-power-fields.js --apply",
    "prisma:push": "prisma db push",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.9",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
